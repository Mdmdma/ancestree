{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(node --check *)",
      "Bash(npx eslint *)",
      "Bash(cd ancestree-app *)",
      "Bash(cd ancestree-backend *)",
      "Bash(git *)",
      "Bash(rsync *)",
      "Bash(ssh *)",
      "Bash(lsof *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/lint-check.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/syntax-check.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
